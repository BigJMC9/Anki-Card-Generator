{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anki Card Generator Desktop",
  "version": "0.1.0",
  "identifier": "com.ankicard.generator.desktop",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sidecar:build && npm run generate"
  },
  "app": {
    "windows": [
      {
        "title": "Anki Card Generator",
        "width": 1380,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/anki-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
